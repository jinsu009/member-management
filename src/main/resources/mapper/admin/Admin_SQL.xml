<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.member.membermanagement.admin.mapper.AdminMapper">

    <!-- 회원 목록 조회 -->
    <select id="selectUserInfoList" resultType="map">
        /* adminDAO.selectUserInfo */
        SELECT seq, user_id, user_pw, name, email, phone, birth_dt, status, reg_dt, mod_dt, use_yn
        FROM member.user_info
    </select>

    <!-- 회원 목록 조회 COUNT -->
    <select id="selectUserInfoListCnt" parameterType="map" resultType="int">
        /* adminDAO.selectUserInfoListCnt */
        SELECT COUNT(*)
        FROM member.user_info
    </select>

    <!-- 회원 상태 수정 -->
    <update id="updateUserInfo" parameterType="map">
        /* adminDAO.updateUserInfo */
        UPDATE member.user_info
        <set>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </set>
        WHERE seq = #{seq}
    </update>

</mapper>